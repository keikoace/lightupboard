# Copy to .env and adjust. Anything omitted falls back to the default in
# config/settings.py, so a local .env only needs the lines you want to change.

# -- Core ----------------------------------------------------------------------
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# -- Database ------------------------------------------------------------------
# DB_ENGINE=sqlite gives a credential-free local database (db.sqlite3).
# Rating changes must still be verified against postgresql -- see settings.py.
DB_ENGINE=postgresql
DB_NAME=lightupnet
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# -- Email rate import (apps/email_import) -------------------------------------
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=rates@yourdomain.com
IMAP_PASSWORD=
IMAP_USE_SSL=true
